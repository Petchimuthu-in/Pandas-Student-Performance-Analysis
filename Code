import pandas as pd

df = pd.read_csv("student_linkedin_practice.csv")

print("Original Dataset:")
print(df)

print("\nStudents with Pandas Mark greater than 80:")
print(df[df["Pandas_Mark"] > 80])

print("\nStudents with Attendance > 80 and Python Mark > 75:")
print(df[(df["Attendance"] > 80) & (df["Python_Mark"] > 75)])

print("\nStudents sorted by Python Mark:")
print(df.sort_values(by="Python_Mark", ascending=False))

print("\nCourse-wise Average Pandas Mark:")
print(df.groupby("Course")["Pandas_Mark"].mean())

print("\nTop 5 Students by Python Mark:")
print(df.nlargest(5, "Python_Mark"))
